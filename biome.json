{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/graphify-out",
			"!!docs",
			"!!data",
			"!!public"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "error"
			},
			"style": {
				"useComponentExportOnlyModules": {
					"level": "warn",
					"options": {
						"allowConstantExport": true
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"useComponentExportOnlyModules": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"style": {
						"useComponentExportOnlyModules": "off"
					},
					"a11y": {
						"noStaticElementInteractions": "off",
						"useKeyWithClickEvents": "off"
					},
					"performance": {
						"noDynamicNamespaceImportAccess": "off"
					}
				}
			}
		}
	]
}
